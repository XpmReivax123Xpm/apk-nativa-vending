<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCatalogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MQ-2103"
                android:textColor="#0965AF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/catalogComposeHost"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/cartFabContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/catalog_cart_bar_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_cart_badge"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="10dp">

                    <FrameLayout
                        android:layout_width="@dimen/catalog_cart_icon_frame_size"
                        android:layout_height="@dimen/catalog_cart_icon_frame_size"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/ivCartBadge"
                            android:layout_width="@dimen/catalog_cart_icon_size"
                            android:layout_height="@dimen/catalog_cart_icon_size"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cart_fab" />

                        <TextView
                            android:id="@+id/tvCartBadge"
                            android:layout_width="@dimen/catalog_cart_count_badge_size"
                            android:layout_height="@dimen/catalog_cart_count_badge_size"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="1dp"
                            android:background="@drawable/bg_cart_count_badge"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/catalog_cart_badge_text"
                            android:textSize="@dimen/catalog_cart_count_text_size"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="@dimen/catalog_cart_divider_height"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="12dp"
                        android:background="@color/catalog_cart_divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total:"
                        android:textColor="@color/catalog_cart_label"
                        android:textSize="@dimen/catalog_cart_total_label_text_size" />

                    <TextView
                        android:id="@+id/tvCartTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="Bs 0.00"
                        android:textColor="@color/catalog_cart_total"
                        android:textSize="@dimen/catalog_cart_total_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/catalog_cart_pay_affordance_height"
                        android:background="@drawable/bg_cart_pay_affordance"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="@dimen/catalog_cart_pay_padding_start"
                        android:paddingRight="@dimen/catalog_cart_pay_padding_end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagar"
                            android:textColor="@color/catalog_cart_pay_text"
                            android:textSize="@dimen/catalog_cart_pay_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="›"
                            android:textColor="@color/catalog_cart_pay_text"
                            android:textSize="@dimen/catalog_cart_pay_arrow_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical|start"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <Button
                android:id="@+id/btnKioskBackToMain"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0965AF"
                android:text="Atras"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnKioskViewLogs"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0B456F"
                android:text="Ver logs"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnKioskViewBitacora"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1F7A8C"
                android:text="Ver bitacora"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/idleVideoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <VideoView
            android:id="@+id/idleVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
