<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D32F2F"
    android:keepScreenOn="true">

    <!-- El tamano (1/3 del ancho de la pantalla) lo fija la activity: el candado se escala en la
         animacion y el viewport del SVG es cuadrado, asi que aca solo importa que sea cuadrado. -->
    <ImageView
        android:id="@+id/ivOutOfServiceLock"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lock_out_of_service" />

    <TextView
        android:id="@+id/tvOutOfServiceMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivOutOfServiceLock"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:text="FUERA DE SERVICIO\nTEMPORALMENTE"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

</RelativeLayout>
