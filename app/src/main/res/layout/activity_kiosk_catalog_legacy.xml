<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCatalogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="MQ-2103"
                android:textColor="#0965AF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCatalogSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text="Madrejon"
                android:textColor="#F28E1B"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/catalogComposeHost"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Carrusel -->
            <ViewFlipper
                android:id="@+id/vfPromoCarousel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/catalog_carousel_height"
                android:autoStart="true"
                android:background="#FFFFFF"
                android:flipInterval="3200"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_catalog_promo_1"
                    android:gravity="bottom|start"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Promo del día"
                        android:textColor="#0965AF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Espacio para ofertas y anuncios"
                        android:textColor="#0965AF"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_catalog_promo_2"
                    android:gravity="bottom|start"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nuevos productos"
                        android:textColor="#0965AF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Carrusel preparado para imágenes"
                        android:textColor="#0965AF"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_catalog_promo_3"
                    android:gravity="bottom|start"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avisos"
                        android:textColor="#F28E1B"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Descuentos, mantenimiento y novedades"
                        android:textColor="#F28E1B"
                        android:textSize="18sp" />
                </LinearLayout>
            </ViewFlipper>

            <TextView
                android:id="@+id/tvCatalogStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_catalog_status"
                android:padding="10dp"
                android:text="Cargando catálogo..."
                android:textColor="#0965AF"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Product catalog pagination -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:visibility="gone">

                <HorizontalScrollView
                    android:id="@+id/catalogProductPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/catalogPagesStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnCatalogPrev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="Previous catalog page"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="#CC0000ff"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/btnCatalogNext"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Next catalog page"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#CC0000FF"
                    android:textSize="40sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/cartFabContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/catalog_cart_bar_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_cart_badge"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="10dp">

                    <FrameLayout
                        android:layout_width="@dimen/catalog_cart_icon_frame_size"
                        android:layout_height="@dimen/catalog_cart_icon_frame_size"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/ivCartBadge"
                            android:layout_width="@dimen/catalog_cart_icon_size"
                            android:layout_height="@dimen/catalog_cart_icon_size"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cart_fab" />

                        <TextView
                            android:id="@+id/tvCartBadge"
                            android:layout_width="@dimen/catalog_cart_count_badge_size"
                            android:layout_height="@dimen/catalog_cart_count_badge_size"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="1dp"
                            android:background="@drawable/bg_cart_count_badge"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/catalog_cart_badge_text"
                            android:textSize="@dimen/catalog_cart_count_text_size"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="@dimen/catalog_cart_divider_height"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="12dp"
                        android:background="@color/catalog_cart_divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total:"
                        android:textColor="@color/catalog_cart_label"
                        android:textSize="@dimen/catalog_cart_total_label_text_size" />

                    <TextView
                        android:id="@+id/tvCartTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="Bs 0.00"
                        android:textColor="@color/catalog_cart_total"
                        android:textSize="@dimen/catalog_cart_total_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/catalog_cart_pay_affordance_height"
                        android:background="@drawable/bg_cart_pay_affordance"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="@dimen/catalog_cart_pay_padding_start"
                        android:paddingRight="@dimen/catalog_cart_pay_padding_end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagar"
                            android:textColor="@color/catalog_cart_pay_text"
                            android:textSize="@dimen/catalog_cart_pay_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="›"
                            android:textColor="@color/catalog_cart_pay_text"
                            android:textSize="@dimen/catalog_cart_pay_arrow_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Footer técnico oculto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical|start"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <Button
                android:id="@+id/btnKioskBackToMain"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0965AF"
                android:text="Atrás"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnKioskViewLogs"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0B456F"
                android:text="Ver logs"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnKioskViewBitacora"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1F7A8C"
                android:text="Ver bitácora"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/idleVideoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <VideoView
            android:id="@+id/idleVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
