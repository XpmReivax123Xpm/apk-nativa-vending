<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="TUVIMOS UNA INCIDENCIA"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivDispenseErrorHero"
            android:layout_width="343dp"
            android:layout_height="358dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="Incidencia"
            android:scaleType="fitCenter"
            android:src="@drawable/tardanza_extra" />

        <TextView
            android:id="@+id/tvDispenseErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Esto está tardando más de lo esperado. Por favor, presione el botón para un reintento manual."
            android:textColor="#0B456F"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressManualDoorRetry"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="26dp"
            android:indeterminateTint="#0B456F"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvManualRetryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text=""
            android:textColor="#0B456F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnManualDoorRetry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#0B456F"
            android:text="Reintento manual"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
